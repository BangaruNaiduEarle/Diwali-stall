# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies and build output
node_modules/
server/node_modules/
dist/
dist-ssr/
server/dist-worker/
*.local

# Environment secrets - never commit
.env
.env.*
!.env.example

server/.env
server/.env.*
!server/.env.example
server/.dev.vars

# Credentials
**/credentials.json
**/*service-account*.json

# Cloudflare Workers
.wrangler/
server/.wrangler/

# Local databases and backups
*.sqlite
*.sqlite3
*.db
backups/
server/data/backups/
server/data/*.sqlite
server/data/*.sqlite-*
server/data/*.sqlite3
server/data/*.db
server/*.sql

# Generated catalogue and private-rate data
server/data/generated/
server/data/catalogue-import.json
server/data/catalogue-public-prices.json

# Local reports and temporary files
server/reports/
server/scripts/_tmp-*
location-audit-result.txt
scripts/pack-preview.txt

# Local acceptance evidence - keep out of Git
docs/report-evidence/

# Editor and operating system files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Local Miniflare persistence data
**/.persist/
