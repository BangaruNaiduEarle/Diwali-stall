yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Cloudflare Workers (server/)
server/.env
server/.dev.vars
server/.wrangler/
server/dist-worker/
*.sqlite
*.sqlite3
*.db
.wrangler/

# Backend secrets / credentials (never commit)
.env
.env.*
!.env.example
server/.env.*
!server/.env.example
**/credentials.json
**/*service-account*.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

```gitignore
# Local environment secrets
.env
.env.*
!.env.example

server/.env
server/.env.*
!server/.env.example
server/.dev.vars

# Cloudflare local development
.wrangler/
server/.wrangler/

# Dependencies and build output
node_modules/
server/node_modules/
dist/
server/dist-worker/

# Local databases and backups
backups/
server/data/backups/
server/data/*.sqlite
server/data/*.sqlite-*
server/data/*.sqlite3
server/data/*.db

# Generated catalogue and private-rate SQL
server/data/generated/

# Local import artefacts (scripts write here; not for git)
server/data/catalogue-import.json
server/data/catalogue-public-prices.json

# Local reports and temporary files
server/reports/
scripts/pack-preview.txt
```
# Explicitly ignore local backup and generated data contents
/backups/**
/server/data/backups/**
/server/data/generated/**

# Local test databases and Wrangler caches
**/.persist/
**/.wrangler/
server/data/backups/
server/data/generated/
server/reports/
