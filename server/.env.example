# Local development only — copy to `.dev.vars` (never commit `.dev.vars`).
# Wrangler loads `.dev.vars` for `wrangler dev`.
#
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
#
# Production admin login (password + session cookie) — see docs/AUTH_PASSWORD.md
# One-time owner setup (min 32 chars; wrangler secret put ADMIN_BOOTSTRAP_SECRET):
# ADMIN_BOOTSTRAP_SECRET=
# Optional session tuning:
# ADMIN_SESSION_TTL_SECONDS=28800
# ADMIN_SESSION_PEPPER=<optional extra secret for IP hashing in rate limits>

# Optional Cloudflare Access (legacy; not required if using password auth)
# CF_ACCESS_TEAM_DOMAIN=yourteam
# CF_ACCESS_AUD=<application AUD tag from Zero Trust dashboard>
#
# Cross-origin browser API access (Vercel SPA → this Worker). Comma-separated origins, no paths.
# Production: set as a plain Worker variable (Dashboard or wrangler deploy --var), NOT a secret.
# Leave unset for same-origin only (no Access-Control-* headers).
# CORS_ALLOWED_ORIGINS=https://diwali-stall.vercel.app
#
# Local admin dev (wrangler dev + loopback only — never add to wrangler.toml [vars] or production secrets)
# ADMIN_LOCAL_DEV_AUTH=1
# ADMIN_LOCAL_DEV_SECRET=<32+ random chars; never commit>
# ADMIN_LOCAL_DEV_EMAIL=you@example.com
# Mint JWT: npm run admin:local-jwt (see server/docs/LOCAL_ADMIN_DEV.md)
#
# Do not add hardcoded admin passwords or production bypass flags here.
#
# Cloudinary (signed upload). Copy to `.dev.vars` with real values.
# Wrangler injects these as Worker env bindings. Never commit `.dev.vars`.
# CLOUDINARY_API_SECRET is used only on the Worker to SHA-1-sign uploads.
# POST /api/admin/uploads/sign never returns the secret.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret