# Copy to `.env.local` for local Vite dev (never commit `.env.local`).

# --- API base URL (no trailing slash) ---
#
# Mode A — Local Wrangler (default): leave empty.
#   Browser calls http://localhost:5173/api/... ; Vite proxies to wrangler dev (127.0.0.1:8787).
#   Requires `npm run dev` in server/ plus local admin setup (see server/docs/LOCAL_ADMIN_DEV.md):
#     - admin_users allowlist row on *local* D1
#     - ADMIN_LOCAL_DEV_JWT here (from `cd server && npm run admin:local-jwt`) for proxied admin API auth
#   Optional: local password login via POST /api/admin/auth/bootstrap-owner (local D1 only).
#
# Mode B — Direct cross-origin Worker (local testing against remote API only):
#   VITE_API_BASE_URL=https://diwali-api.your-account.workers.dev
#   Worker CORS_ALLOWED_ORIGINS must include http://localhost:5173.
#   Browser session cookies may fail (third-party cookie restrictions); prefer Mode A locally.
#
VITE_API_BASE_URL=

# Vercel production: leave VITE_API_BASE_URL unset (or empty). vercel.json rewrites /api/* to the Worker.
# Redeploy after changing env vars. Do not point the browser directly at *.workers.dev in production builds.

# Optional: wrangler dev URL for Vite proxy when VITE_API_BASE_URL is empty (default http://127.0.0.1:8787).
# VITE_DEV_API_PROXY=http://127.0.0.1:8789

# Optional: Vite dev proxy injects Cf-Access-Jwt-Assertion (Node-only; not in browser bundle).
# cd server && npm run admin:local-jwt
# ADMIN_LOCAL_DEV_JWT=
